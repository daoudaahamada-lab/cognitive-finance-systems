# Postgres connection (docker compose up -d starts one on 5432)
DATABASE_URL="postgresql://vela:vela@localhost:5432/vela"

# --- LinkedIn in a browser (accounts connected as "Mon compte LinkedIn") ---
# Only the worker opens Chromium; the web app reaches it through a local bridge.
# Install the browser once: npx playwright-core install chromium
# One persistent Chromium profile per account (keep it private, never commit it).
LINKEDIN_PROFILES_DIR=".linkedin-profiles"
# "false" shows the browser window (useful to watch the first runs).
LINKEDIN_HEADLESS="true"
# Optional: use an installed Chrome/Chromium instead of Playwright's.
LINKEDIN_CHROMIUM_PATH=""
# Multiplies the human-like pauses between actions. Keep 1 or more on a real account.
LINKEDIN_PACE="1"
# Minimum minutes between two scans of new connections and messages.
LINKEDIN_EVENTS_INTERVAL_MINUTES="15"
# Bridge between the web app and the worker (127.0.0.1 only). The secret defaults
# to a value derived from DATABASE_URL, so both processes agree without config.
LINKEDIN_BRIDGE_PORT="4319"
LINKEDIN_BRIDGE_SECRET=""

# AI agents. With ANTHROPIC_API_KEY set, Claude scores prospects, personalizes
# messages and answers replies; rule-based agents take over on any failure.
ANTHROPIC_API_KEY=""
# Optional: force "claude" or "rules" (default: claude when a key is set).
AGENTS=""
# Optional: model used by the agents.
ANTHROPIC_MODEL="claude-opus-5-5"

# Speeds up waits (follow-up delays, simulated replies). 1 = real time.
# 720 turns one day into two minutes. Quotas are never scaled.
TIME_SCALE="720"

# Shared secret for POST /api/engine/tick (external cron). Leave empty to disable the route.
ENGINE_TICK_SECRET=""

# How often the worker runs the engine, in seconds.
WORKER_INTERVAL_SECONDS="10"

# Public URL used by the sitemap and robots.txt.
SITE_URL="http://localhost:3000"

# Signup closes once the first account exists; "true" reopens it.
ALLOW_SIGNUP=""
