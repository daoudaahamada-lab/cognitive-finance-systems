# Postgres connection (docker compose up -d starts one on 5432)
DATABASE_URL="postgresql://vela:vela@localhost:5432/vela"

# LinkedIn provider: "simulator" is the only one shipped in this iteration.
LINKEDIN_PROVIDER="simulator"

# AI agents. With ANTHROPIC_API_KEY set, Claude scores prospects, personalizes
# messages and answers replies; rule-based agents take over on any failure.
ANTHROPIC_API_KEY=""
# Optional: force "claude" or "rules" (default: claude when a key is set).
AGENTS=""
# Optional: model used by the agents.
ANTHROPIC_MODEL="claude-opus-5-5"

# Speeds up waits (follow-up delays, simulated replies). 1 = real time.
# 720 turns one day into two minutes. Quotas are never scaled.
TIME_SCALE="720"

# Shared secret for POST /api/engine/tick (external cron). Leave empty to disable the route.
ENGINE_TICK_SECRET=""

# How often the worker runs the engine, in seconds.
WORKER_INTERVAL_SECONDS="10"

# Public URL used by the sitemap and robots.txt.
SITE_URL="http://localhost:3000"
